{
  "manifest_version": 3,
  "name": "CrOS New Tab",
  "version": "0.4.0",
  "description": "Полноценный рабочий стол для ChromeOS в новой вкладке: виджеты с закреплением, сетка, сервисы Google и погода.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "management",
    "search",
    "unlimitedStorage",
    "tabs",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://news.google.com/*"
  ]
}
