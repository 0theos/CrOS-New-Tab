{
  "manifest_version": 3,
  "name": "CrOS New Tab",
  "version": "1.1.0",
  "description": "Пустая новая вкладка с адаптацией под цветовую гамму ChromeOS.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "management"
  ]
}
